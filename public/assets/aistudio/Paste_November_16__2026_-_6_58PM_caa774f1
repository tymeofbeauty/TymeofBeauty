    <script>
        document.addEventListener('DOMContentLoaded', () => {
            
            // 1. Splash Screen Configuration & Logic
            const urlParams = new URLSearchParams(window.location.search);
            const splash = document.getElementById('splash');
            const counter = document.getElementById('splash-counter');
            const main = document.getElementById('main-content');
            const menuBtn = document.getElementById('menu-btn');
            const nav = document.querySelector('nav');

            const startApp = () => {
                document.body.classList.remove('overflow-hidden');
                main.classList.remove('opacity-0');
            };

            // ?autostart=1 support for skipping splash screen
            if (urlParams.get('autostart') === '1') {
                splash.style.display = 'none';
                startApp();
            } else {
                // 2000ms counter duration
                let startTimestamp = null;
                const duration = 2000;
                
                const step = (timestamp) => {
                    if (!startTimestamp) startTimestamp = timestamp;
                    const progress = timestamp - startTimestamp;
                    const val = Math.min(Math.floor((progress / duration) * 100), 100);
                    
                    counter.innerText = val;
                    
                    if (progress < duration) {
                        window.requestAnimationFrame(step);
                    } else {
                        // Hold 200ms at 100
                        setTimeout(() => {
                            // Fade out over 700ms
                            splash.style.opacity = '0';
                            setTimeout(() => {
                                splash.style.display = 'none';
                                startApp();
                            }, 700);
                        }, 200);
                    }
                };
                window.requestAnimationFrame(step);
            }

            // 2. Navbar & Staggered Slide-Out Menu Logic
            const mobileMenu = document.getElementById('mobile-menu');
            const spans = menuBtn.querySelectorAll('span');
            let isMenuOpen = false;

            menuBtn.addEventListener('click', () => {
                isMenuOpen = !isMenuOpen;
                if(isMenuOpen) {
                    // Open Menu
                    mobileMenu.classList.remove('pointer-events-none', 'opacity-0');
                    mobileMenu.classList.add('menu-open');
                    nav.classList.add('bg-transparent', 'border-transparent');
                    nav.classList.remove('bg-page/80', 'backdrop-blur-xl', 'border-tertiary/40');
                    // Animate Hamburger to X
                    spans[0].style.transform = 'translateY(8px) rotate(45deg)';
                    spans[0].classList.replace('bg-neutral', 'bg-page');
                    spans[1].style.opacity = '0';
                    spans[2].style.transform = 'translateY(-8px) rotate(-45deg)';
                    spans[2].classList.replace('bg-neutral', 'bg-page');
                } else {
                    // Close Menu
                    mobileMenu.classList.add('pointer-events-none', 'opacity-0');
                    mobileMenu.classList.remove('menu-open');
                    nav.classList.add('bg-page/80', 'backdrop-blur-xl', 'border-tertiary/40');
                    nav.classList.remove('bg-transparent', 'border-transparent');
                    // Revert X to Hamburger
                    spans[0].style.transform = 'none';
                    spans[0].classList.replace('bg-page', 'bg-neutral');
                    spans[1].style.opacity = '1';
                    spans[2].style.transform = 'none';
                    spans[2].classList.replace('bg-page', 'bg-neutral');
                }
            });

            // 3. Conversion Flow Contact Form (Inline validation & Mock Sheet API)
            const form = document.getElementById('contact-form');
            const nameInput = document.getElementById('name');
            const emailInput = document.getElementById('email');
            
            const errName = document.getElementById('err-name');
            const errEmail = document.getElementById('err-email');
            
            // Real-time Email Regex validation
            const validateEmail = (email) => {
                return String(email).toLowerCase().match(
                    /^(([^<>()[\]\\.,;:\s@"]+(\.[^<>()[\]\\.,;:\s@"]+)*)|.(".+"))@((\[[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}\])|(([a-zA-Z\-0-9]+\.)+[a-zA-Z]{2,}))$/
                );
            };

            // Inline Check Listeners
            nameInput.addEventListener('input', () => {
                errName.style.display = nameInput.value.trim().length >= 2 ? 'none' : 'block';
            });
            
            emailInput.addEventListener('input', () => {
                errEmail.style.display = validateEmail(emailInput.value) ? 'none' : 'block';
            });

            // Form Submit Intercept (Endpoint Mock)
            form.addEventListener('submit', (e) => {
                e.preventDefault();
                
                const isNameValid = nameInput.value.trim().length >= 2;
                const isEmailValid = validateEmail(emailInput.value);

                if(!isNameValid) errName.style.display = 'block';
                if(!isEmailValid) errEmail.style.display = 'block';

                if(!isNameValid || !isEmailValid) return;

                // Elements setup for loading state
                const submitBtn = document.getElementById('submit-btn');
                const btnText = document.getElementById('btn-text');
                const spinner = document.getElementById('spinner');
                const successMsg = document.getElementById('success-msg');
                const refIdDisplay = document.getElementById('ref-id');

                // Enter Loading State
                submitBtn.disabled = true;
                submitBtn.classList.replace('hover:bg-secondary', 'opacity-70');
                btnText.innerText = 'Connecting...';
                spinner.classList.remove('hidden');

                // Simulate fetch to /api/contact/sheets endpoint (1500ms delay)
                setTimeout(() => {
                    // Generate Reference ID
                    const generatedRefId = 'TYME-' + Math.random().toString(36).substring(2, 7).toUpperCase();
                    
                    // Show Completion Feedback
                    submitBtn.classList.add('hidden');
                    successMsg.classList.remove('hidden');
                    refIdDisplay.innerText = generatedRefId;
                    
                    // Optionally reset form
                    // form.reset(); 
                }, 1500);
            });
        });
    </script>