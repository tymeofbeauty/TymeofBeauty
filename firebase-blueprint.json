{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Authenticated user profile and Workspace spreadsheet metadata.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Firebase Auth UID of the user."
        },
        "displayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120,
          "description": "User display name."
        },
        "email": {
          "type": "string",
          "format": "email",
          "minLength": 3,
          "maxLength": 200,
          "description": "User email address."
        },
        "photoURL": {
          "type": "string",
          "maxLength": 500,
          "description": "User avatar URL."
        },
        "preferredLanguage": {
          "type": "string",
          "enum": ["en", "th"],
          "description": "Preferred UI and AI response language."
        },
        "spreadsheetId": {
          "type": "string",
          "maxLength": 150,
          "description": "Linked Google Sheets spreadsheet ID for form submissions."
        },
        "spreadsheetUrl": {
          "type": "string",
          "maxLength": 500,
          "description": "Linked Google Sheets URL."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server last update timestamp."
        }
      },
      "required": ["uid", "displayName", "email", "preferredLanguage", "createdAt", "updatedAt"]
    },
    "ChatSession": {
      "title": "ChatSession",
      "description": "Saved Gemini conversation session for an authenticated user.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "userId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "language": {
          "type": "string",
          "enum": ["en", "th"]
        },
        "messageCount": {
          "type": "integer"
        },
        "lastMessagePreview": {
          "type": "string",
          "maxLength": 200
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["id", "userId", "title", "language", "messageCount", "lastMessagePreview", "createdAt", "updatedAt"]
    },
    "ChatMessage": {
      "title": "ChatMessage",
      "description": "Individual message turn inside a saved chat session.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "sessionId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "userId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "role": {
          "type": "string",
          "enum": ["user", "model"]
        },
        "content": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32000
        },
        "sources": {
          "type": "array",
          "description": "Up to 8 Google Doc titles cited for this response."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["id", "sessionId", "userId", "role", "content", "sources", "createdAt"]
    },
    "UserMemory": {
      "title": "UserMemory",
      "description": "Persistent user preference or factual memory item for personalized AI chats.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "userId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "fact": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "category": {
          "type": "string",
          "enum": ["preference", "goal", "beauty", "career", "partner"]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["id", "userId", "fact", "category", "createdAt", "updatedAt"]
    },
    "DocChunk": {
      "title": "DocChunk",
      "description": "Vector-embedded text chunk indexed from a user's private Google Doc.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "userId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "documentId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 150
        },
        "documentTitle": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "chunkIndex": {
          "type": "integer"
        },
        "content": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        },
        "embedding": {
          "type": "array",
          "description": "Numeric embedding vector from gemini-embedding-2."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["id", "userId", "documentId", "documentTitle", "chunkIndex", "content", "embedding", "createdAt"]
    },
    "ContactSubmission": {
      "title": "ContactSubmission",
      "description": "Conversion contact form submission synced to Google Sheets.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "userId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "referenceId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "fullName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "email": {
          "type": "string",
          "format": "email",
          "minLength": 3,
          "maxLength": 200
        },
        "phone": {
          "type": "string",
          "minLength": 6,
          "maxLength": 30
        },
        "interest": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "preferredDate": {
          "type": "string",
          "maxLength": 40
        },
        "notes": {
          "type": "string",
          "maxLength": 1000
        },
        "language": {
          "type": "string",
          "enum": ["en", "th"]
        },
        "spreadsheetId": {
          "type": "string",
          "maxLength": 150
        },
        "spreadsheetUrl": {
          "type": "string",
          "maxLength": 500
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["id", "userId", "referenceId", "fullName", "email", "phone", "interest", "language", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Private user profile and linked Google Sheet reference."
    },
    "/users/{userId}/sessions/{sessionId}": {
      "schema": { "$ref": "#/entities/ChatSession" },
      "description": "Saved chat sessions owned by the user."
    },
    "/users/{userId}/sessions/{sessionId}/messages/{messageId}": {
      "schema": { "$ref": "#/entities/ChatMessage" },
      "description": "Messages inside a user's saved chat session."
    },
    "/users/{userId}/memories/{memoryId}": {
      "schema": { "$ref": "#/entities/UserMemory" },
      "description": "Persistent user memories used for personalized Gemini chat context."
    },
    "/users/{userId}/docChunks/{chunkId}": {
      "schema": { "$ref": "#/entities/DocChunk" },
      "description": "Private user-specific vector embeddings indexed from Google Docs."
    },
    "/users/{userId}/submissions/{submissionId}": {
      "schema": { "$ref": "#/entities/ContactSubmission" },
      "description": "User's conversion contact form submissions and Sheet references."
    }
  }
}
